<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Incomplete progress ring representing goal progress -->
    <path
        android:pathData="M 54,24 A 30,30 0 1,0 84,54"
        android:strokeWidth="7"
        android:strokeLineCap="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="24"
                android:startY="24"
                android:endX="84"
                android:endY="84">
                <item android:color="#8B5CF6" android:offset="0.0" />
                <item android:color="#06B6D4" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Sleek thick checkmark representing completion -->
    <path
        android:pathData="M 40,54 L 50,64 L 72,36"
        android:strokeWidth="8"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="#00000000">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:type="linear"
                android:startX="40"
                android:startY="36"
                android:endX="72"
                android:endY="64">
                <item android:color="#06B6D4" android:offset="0.0" />
                <item android:color="#8B5CF6" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Minimalist flame spark representing streaks -->
    <path
        android:pathData="M 78,22 C 75,25 74,28 74,31 C 74,34 76,36 78,36 C 80,36 82,34 82,31 C 82,27 79,24 78,22 Z"
        android:fillColor="#F43F5E" />

</vector>
